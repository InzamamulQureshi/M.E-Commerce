# ==============================================================================
# M.E-Commerce Environment Configuration Template
# ==============================================================================

# Database Connection (MySQL / Dokploy / Hostinger / PlanetScale / Railway)
DATABASE_URL="mysql://username:password@localhost:3306/mecommerce"

# Secret Authentication Keys (Kept strictly on server side)
BETTER_AUTH_SECRET="replace_with_long_random_secret_string"
ADMIN_SECRET_KEY="replace_with_secure_admin_password"
ADMIN_EMAIL="admin@mecommerce.dev"

# Public Store Branding & Contact
NEXT_PUBLIC_STORE_NAME="M.E-Commerce"
NEXT_PUBLIC_STORE_TAGLINE="Modern, Minimalist & Modular E-Commerce"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/mecommerce.official"
NEXT_PUBLIC_WHATSAPP="+919876543210"
NEXT_PUBLIC_UPI_ID="mecommerce@oksbi"
NEXT_PUBLIC_UPI_NAME="M.E-Commerce Studio"

# ------------------------------------------------------------------------------
# 1. Demo Admin Account (Disabled by Default for Security on Clones/Forks)
# ------------------------------------------------------------------------------
# Set to "true" only if you want to enable the 1-click read-only Demo Admin
ENABLE_DEMO_ADMIN="false"
NEXT_PUBLIC_ENABLE_DEMO_ADMIN="false"
DEMO_ADMIN_EMAIL="demo@mecommerce.dev"
DEMO_ADMIN_PASSWORD="demo"

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Cards, Netbanking, UPI, Wallets)
# ------------------------------------------------------------------------------
# Leave empty to seamlessly fallback to Manual UPI QR & Cash on Delivery (COD)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ------------------------------------------------------------------------------
# 3. Stripe Extensible Gateway (Optional Future Activation)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ------------------------------------------------------------------------------
# 4. React Email System (Resend Provider)
# ------------------------------------------------------------------------------
# Leave empty to fallback to development state (console logs OTP & provides devCode)
RESEND_API_KEY=""
REACT_EMAIL_SECRET_KEY=""
EMAIL_FROM="M.E-Commerce <onboarding@resend.dev>"
